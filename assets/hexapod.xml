<!--
  hexapod.xml  —  MuJoCo model for a 6-DOF × 3-joint hexapod
  ============================================================

  Leg kinematic chain (per leg, 3 DOF):
    torso
      └─ legX_base          (rigid attachment on torso side)
           └─ legX_coxa_j   (hinge, axis Z — yaw, sweeps leg in/out)
                └─ legX_femur  [OFFSET 0.025 m along coxa local-X]
                     └─ legX_femur_j  (hinge, axis Y — pitch, lifts/lowers femur)
                          └─ legX_tibia  [OFFSET 0.10 m along femur local-Z]
                               └─ legX_tibia_j  (hinge, axis Y — pitch, knee flex)
                                    └─ tip_legX  [OFFSET 0.10 m along tibia local-Z]

  Link lengths used by FK/IK (see assets/config.py):
    coxa  = 0.025 m   (lateral stub between coxa joint and femur joint)
    femur = 0.100 m   (femur joint to tibia joint)
    tibia = 0.100 m   (tibia joint to foot tip)

  Coxa joint ranges (degrees) are given in the principal [-180, 180] convention
  so they match the actuator ctrlrange values (radians, same convention).

  Actuator model: position servos with
    kp  — proportional position gain   (N·m / rad)
    kv  — velocity feedback gain       (N·m·s / rad)  — added for realism
    forcerange — peak torque ± 2.5 N·m (small servo, e.g. Dynamixel XL430)

  Joint physics:
    damping     = 0.5   N·m·s/rad  (implicit servo internal damping)
    armature    = 0.004 kg·m²       (rotor inertia of a small servo)
    frictionloss= 0.01  N·m         (static friction threshold)
-->

<mujoco model="hexapod">
    <compiler autolimits="true"/>

    <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton"/>

    <asset>
        <texture name="grid" type="2d" builtin="checker"
                 width="512" height="512"
                 rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid"
                  texrepeat="1 1" texuniform="true" reflectance=".2"/>
        <material name="body_mat" rgba="0.25 0.25 0.25 1"/>
        <material name="leg_mat"  rgba="0.80 0.20 0.20 1"/>
        <material name="tip_mat"  rgba="0.10 0.80 0.10 1"/>
    </asset>

    <default>
        <!--
          Joint defaults:  damping  — viscous drag (servo friction)
                           armature — rotor/gear inertia (makes dynamics realistic)
                           frictionloss — Coulomb friction at zero velocity
        -->
        <joint damping="0.5" armature="0.004" frictionloss="0.01"/>

        <!--
          Position actuator defaults:
            kv   — derivative (velocity) gain: 2*sqrt(kp*armature) ≈ critically damped
                   for kp=30, armature=0.004 → kv ≈ 0.69; use 0.5 (slightly underdamped)
            forcerange — servo peak torque ±2.5 N·m
        -->
        <position kv="0.5" forcerange="-2.5 2.5"/>
    </default>

    <worldbody>
        <!-- Ground plane — high lateral friction for stable foot contact -->
        <geom type="plane" size="5 5 0.01" material="grid"
              friction="1.2 0.005 0.0001"/>

        <!-- Overhead tracking light -->
        <light name="sun" pos="0 0 2" mode="trackcom" diffuse="0.85 0.85 0.85"/>

        <!-- ══════════════════════════════════════════════════════════
             TORSO — free-floating body
             Starts at z=0.15 m so legs settle to ground cleanly.
             Mass 1.0 kg (realistic for a hobby-scale hexapod).
             ══════════════════════════════════════════════════════════ -->
        <body name="torso" pos="0 0 0.15">
            <freejoint/>
            <geom type="box" size="0.08 0.05 0.02"
                  material="body_mat" mass="1.0"/>
            <site name="imu_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>

            <!-- ══════════════════════════════════════════════════════
                 LEG 0  —  LEFT FRONT
                 Coxa base at (+0.10, +0.05, 0) on torso.
                 Coxa sweep range: 0° to 90°  (neutral ≈ 45°, faces front-left)
                 ══════════════════════════════════════════════════════ -->
            <body name="leg0_base" pos="0.10 0.05 0">
                <joint name="leg0_coxa_j" type="hinge" axis="0 0 1" range="0 90"/>
                <!-- Coxa segment: 25 mm stub along local +X (toward femur joint) -->
                <geom name="leg0_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <!-- Femur body offset 25 mm from coxa joint along coxa local-X -->
                <body name="leg0_femur" pos="0.025 0 0">
                    <joint name="leg0_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg0_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg0_tibia" pos="0 0 0.1">
                        <joint name="leg0_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg0_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg0" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

            <!-- ══════════════════════════════════════════════════════
                 LEG 1  —  RIGHT FRONT
                 Coxa base at (+0.10, −0.05, 0).
                 Coxa sweep range: −90° to 0°  (neutral ≈ −45°, faces front-right)
                 ══════════════════════════════════════════════════════ -->
            <body name="leg1_base" pos="0.10 -0.05 0">
                <joint name="leg1_coxa_j" type="hinge" axis="0 0 1" range="-90 0"/>
                <geom name="leg1_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <body name="leg1_femur" pos="0.025 0 0">
                    <joint name="leg1_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg1_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg1_tibia" pos="0 0 0.1">
                        <joint name="leg1_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg1_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg1" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

            <!-- ══════════════════════════════════════════════════════
                 LEG 2  —  LEFT MID
                 Coxa base at (0, +0.05, 0).
                 Coxa sweep range: 45° to 135°  (neutral = 90°, faces pure left)
                 ══════════════════════════════════════════════════════ -->
            <body name="leg2_base" pos="0 0.05 0">
                <joint name="leg2_coxa_j" type="hinge" axis="0 0 1" range="45 135"/>
                <geom name="leg2_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <body name="leg2_femur" pos="0.025 0 0">
                    <joint name="leg2_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg2_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg2_tibia" pos="0 0 0.1">
                        <joint name="leg2_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg2_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg2" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

            <!-- ══════════════════════════════════════════════════════
                 LEG 3  —  RIGHT MID
                 Coxa base at (0, −0.05, 0).
                 Coxa sweep range: −135° to −45°  (neutral = −90°, faces pure right)
                 Note: range kept in [−180, 180] to match ctrlrange convention.
                 ══════════════════════════════════════════════════════ -->
            <body name="leg3_base" pos="0 -0.05 0">
                <joint name="leg3_coxa_j" type="hinge" axis="0 0 1" range="-135 -45"/>
                <geom name="leg3_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <body name="leg3_femur" pos="0.025 0 0">
                    <joint name="leg3_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg3_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg3_tibia" pos="0 0 0.1">
                        <joint name="leg3_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg3_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg3" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

            <!-- ══════════════════════════════════════════════════════
                 LEG 4  —  LEFT REAR
                 Coxa base at (−0.10, +0.05, 0).
                 Coxa sweep range: 90° to 180°  (neutral = 135°, faces rear-left)
                 ══════════════════════════════════════════════════════ -->
            <body name="leg4_base" pos="-0.10 0.05 0">
                <joint name="leg4_coxa_j" type="hinge" axis="0 0 1" range="90 180"/>
                <geom name="leg4_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <body name="leg4_femur" pos="0.025 0 0">
                    <joint name="leg4_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg4_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg4_tibia" pos="0 0 0.1">
                        <joint name="leg4_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg4_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg4" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

            <!-- ══════════════════════════════════════════════════════
                 LEG 5  —  RIGHT REAR
                 Coxa base at (−0.10, −0.05, 0).
                 Coxa sweep range: −180° to −90°  (neutral = −135°, faces rear-right)
                 ══════════════════════════════════════════════════════ -->
            <body name="leg5_base" pos="-0.10 -0.05 0">
                <joint name="leg5_coxa_j" type="hinge" axis="0 0 1" range="-180 -90"/>
                <geom name="leg5_coxa_g" type="capsule" size="0.008 0.0125"
                      pos="0.0125 0 0" euler="0 90 0"
                      material="leg_mat" mass="0.03"/>

                <body name="leg5_femur" pos="0.025 0 0">
                    <joint name="leg5_femur_j" type="hinge" axis="0 1 0" range="30 75"/>
                    <geom name="leg5_femur_g" type="capsule" size="0.009 0.04"
                          pos="0 0 0.05" material="leg_mat" mass="0.04"/>

                    <body name="leg5_tibia" pos="0 0 0.1">
                        <joint name="leg5_tibia_j" type="hinge" axis="0 1 0" range="15 105"/>
                        <geom name="leg5_tibia_g" type="capsule" size="0.008 0.045"
                              pos="0 0 0.05" material="leg_mat" mass="0.04"
                              friction="1.5 0.05 0.01"/>
                        <site name="tip_leg5" pos="0 0 0.1" size="0.012" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>

        </body>
    </worldbody>

    <!-- ══════════════════════════════════════════════════════════════════
         ACTUATORS — position-controlled servos
         kp  : proportional gain (N·m/rad) — servo stiffness
         kv  : derivative gain  (N·m·s/rad) — inherited from <default>
         forcerange : ±2.5 N·m peak torque — inherited from <default>
         ctrlrange  : matches joint limits (radians, [−π, π] convention)
         ══════════════════════════════════════════════════════════════════ -->
    <actuator>
        <!-- Coxa joints — higher kp for crisp yaw response -->
        <position name="act_leg0_coxa"  joint="leg0_coxa_j"  kp="30" ctrlrange="0.00  1.57"/>
        <position name="act_leg1_coxa"  joint="leg1_coxa_j"  kp="30" ctrlrange="-1.57 0.00"/>
        <position name="act_leg2_coxa"  joint="leg2_coxa_j"  kp="30" ctrlrange="0.79  2.36"/>
        <position name="act_leg3_coxa"  joint="leg3_coxa_j"  kp="30" ctrlrange="-2.36 -0.79"/>
        <position name="act_leg4_coxa"  joint="leg4_coxa_j"  kp="30" ctrlrange="1.57  3.14"/>
        <position name="act_leg5_coxa"  joint="leg5_coxa_j"  kp="30" ctrlrange="-3.14 -1.57"/>

        <!-- Femur joints — moderate gain, carries body weight -->
        <position name="act_leg0_femur" joint="leg0_femur_j" kp="28" ctrlrange="0.52  1.31"/>
        <position name="act_leg1_femur" joint="leg1_femur_j" kp="28" ctrlrange="0.52  1.31"/>
        <position name="act_leg2_femur" joint="leg2_femur_j" kp="28" ctrlrange="0.52  1.31"/>
        <position name="act_leg3_femur" joint="leg3_femur_j" kp="28" ctrlrange="0.52  1.31"/>
        <position name="act_leg4_femur" joint="leg4_femur_j" kp="28" ctrlrange="0.52  1.31"/>
        <position name="act_leg5_femur" joint="leg5_femur_j" kp="28" ctrlrange="0.52  1.31"/>

        <!-- Tibia joints — lower kp, controls foot strike angle -->
        <position name="act_leg0_tibia" joint="leg0_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
        <position name="act_leg1_tibia" joint="leg1_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
        <position name="act_leg2_tibia" joint="leg2_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
        <position name="act_leg3_tibia" joint="leg3_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
        <position name="act_leg4_tibia" joint="leg4_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
        <position name="act_leg5_tibia" joint="leg5_tibia_j" kp="22" ctrlrange="0.26  1.83"/>
    </actuator>

    <!-- ══════════════════════════════════════════════════════════════════
         SENSORS
           torso_orientation : quaternion (body orientation feedback)
           torso_gyro        : angular velocity (body IMU)
           touch_legX        : binary contact force at each foot tip
         ══════════════════════════════════════════════════════════════════ -->
    <sensor>
        <framequat name="torso_orientation" objtype="body" objname="torso"/>
        <gyro      name="torso_gyro"        site="imu_site"/>
        <touch name="touch_leg0" site="tip_leg0"/>
        <touch name="touch_leg1" site="tip_leg1"/>
        <touch name="touch_leg2" site="tip_leg2"/>
        <touch name="touch_leg3" site="tip_leg3"/>
        <touch name="touch_leg4" site="tip_leg4"/>
        <touch name="touch_leg5" site="tip_leg5"/>
    </sensor>

</mujoco>
